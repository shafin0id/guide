# GUIDE Multi-Agent Framework Environment Configuration
# Copy this file to .env and insert your API keys for live evaluation runs.

# Foundation Model Providers (LiteLLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: Strict Live Mode (set to 1 to fail loudly on API error rather than falling back to offline simulation)
GUIDE_STRICT_LIVE=0

# Framework Configuration Overrides (prefixed with GUIDE_)
# GUIDE_MODEL__MODEL_NAME=claude-3-5-sonnet-20241022
# GUIDE_MODEL__TEMPERATURE=0.0
# GUIDE_MODEL__SEED=42
