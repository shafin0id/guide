# GUIDE bench live-run credentials.
# Copy to .env (gitignored) and fill in real keys. Loaded via `guide-bench --env-file .env`.
# guide_bench.run.load_env_file() only *sets* a variable if it is not already in the
# environment (os.environ.setdefault) -- an exported shell var always wins over this file.

# Primary model for all reported protocol-v1..v4 results (src/guide_bench/run.py --key-env default)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Additional model families for protocol-v5 (docs/experiments.md "Protocol v5") -- free tiers
GEMINI_API_KEY=
GROQ_API_KEY=
